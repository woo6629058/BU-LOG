# EC2/production example. Copy values into the server environment; do not commit .env.
# 운영 서버에서는 /opt/bulog/.env 에 두고 deploy/deploy.sh 가 docker --env-file 로 읽는다.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# HTTPS 적용 전에는 false, HTTPS 적용 후 true
COOKIE_SECURE=true
# RDS 예시: jdbc:mysql://<RDS 엔드포인트>:3306/bulog?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
DB_URL=jdbc:mysql://localhost:3306/bulog?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
DB_USERNAME=bulog
DB_PASSWORD=change-me
JPA_DDL_AUTO=update
HIBERNATE_FORMAT_SQL=false
LOG_LEVEL=INFO

# e뮤지엄 박물관 소장품 공공데이터 API
EMUSEUM_API_BASE_URL=http://apis.data.go.kr/1371027/openapi
EMUSEUM_API_SERVICE_KEY=replace-with-data-go-kr-service-key
EMUSEUM_INSTITUTION_CODE=PS01003464
EMUSEUM_SYNC_ENABLED=false
EMUSEUM_SYNC_PAGE_SIZE=1000
